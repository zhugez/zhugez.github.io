{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhugez",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "workers_dev": true
}
