{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhugez",
  "main": "worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/media/vinyl/*.m4a"]
  },
  "workers_dev": true,
  "routes": [{ "pattern": "lyngocvu.tech", "custom_domain": true }]
}
